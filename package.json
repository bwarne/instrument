{
  "name": "instrument",
  "version": "1.0.7",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node --env-file-if-exists=.env server.js",
    "app": "sh build/dev-name.sh && electron .",
    "dist": "NODE_OPTIONS=--experimental-require-module electron-builder --mac --dir",
    "release": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-instrument-notary} NODE_OPTIONS=--experimental-require-module electron-builder --mac dmg zip --publish never && node build/check-bundle.mjs",
    "publish": "sh build/publish.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Describe a sound, Claude writes SuperCollider, run it live. A learning instrument.",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@breezystack/lamejs": "^1.2.7",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "AnInstrument",
  "build": {
    "appId": "net.jonowar.instrument",
    "productName": "AnInstrument",
    "files": [
      "server.js",
      "index.html",
      "*.scd",
      "electron/**",
      "package.json",
      "!**/node_modules/**/*.{map,d.ts,d.mts,d.cts,md,markdown}",
      "!**/node_modules/**/{docs,test,tests,__tests__,examples}/**"
    ],
    "asarUnpack": [
      "*.scd"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dir",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en"
    ],
    "publish": {
      "provider": "github",
      "owner": "jonowar",
      "repo": "instrument"
    }
  }
}
