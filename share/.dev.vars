# Local development only. `wrangler dev` reads this; `wrangler deploy` never uploads it, so a
# deployment always has the flood limiter on.
#
# This file is committed, unlike most .dev.vars. Don't put secrets in it. Real secrets go through
# `wrangler secret put`, which never touches the repo.
#
# The flood limiter counts every upload against a single bucket, so two test runs inside a minute
# would start returning 429 for reasons that have nothing to do with what is being tested. The
# per-IP limiter stays on, and one test still proves it works.
SHARE_FLOOD_OFF=1
